# ──────────────────────────────────────────────────────────────────────
# ms_orchestrator — Environment Variables Configuration
# ──────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# Service Identification
# ─────────────────────────────────────────────────────────────────────
SERVICE_NAME=ms_orchestrator
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────────────
# Orchestrator Settings
# ─────────────────────────────────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_WORKERS=4

# ─────────────────────────────────────────────────────────────────────
# Microservices URLs
# ─────────────────────────────────────────────────────────────────────

# Validation microservice
VALIDATION_SERVICE_URL=http://localhost:8001

# Backend API (IA Service Core)
BACKEND_API_URL=http://localhost:8003

# Database microservice
MICROSERVICE_DB_URL=http://localhost:8002

# Django Backend (apps/)
DJANGO_BACKEND_URL=http://localhost:8000

# Service timeouts (seconds)
SERVICE_TIMEOUT=30
SERVICE_CONNECT_TIMEOUT=10

# ─────────────────────────────────────────────────────────────────────
# Retry Settings
# ─────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2.0
RETRY_INITIAL_DELAY=1.0

# ─────────────────────────────────────────────────────────────────────
# Circuit Breaker Settings
# ─────────────────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ─────────────────────────────────────────────────────────────────────
# Logging Settings
# ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_RESPONSE_LOGGING=true

# ─────────────────────────────────────────────────────────────────────
# CORS Settings
# ─────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ─────────────────────────────────────────────────────────────────────
# Security Settings
# ─────────────────────────────────────────────────────────────────────
API_KEY_HEADER=X-API-Key
ENABLE_API_KEY_VALIDATION=false
VALID_API_KEYS=[]
