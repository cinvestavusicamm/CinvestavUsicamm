# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# En desarrollo puede quedar vacio: se usa un SQLite local (db.sqlite3).
# Si se rellena, tiene que apuntar a la base local del docker-compose; el
# proyecto se niega a arrancar contra un host remoto salvo que se exporte
# ALLOW_REMOTE_DB=1.
# En produccion es obligatoria y no admite SQLite.
DATABASE_URL=postgresql://user:password@localhost:5432/cinvestav_db

ALLOWED_HOSTS=localhost,127.0.0.1

# Microservices URLs
VALIDATION_SERVICE_URL=http://localhost:8001
BACKEND_API_URL=http://localhost:8003
MICROSERVICE_DB_URL=http://localhost:8002
DJANGO_BACKEND_URL=http://localhost:8000

# Clave compartida con el microservicio de IA. Django la manda en la cabecera
# X-Internal-Service-Key de /agente-ajax/ y el microservicio la exige en /ask.
# Este es el nombre canonico: lo leen los dos lados (Django con
# config('INTERNAL_SERVICE_KEY'), el microservicio con
# os.getenv('INTERNAL_SERVICE_KEY')). Los compose la inyectan con
# ${INTERNAL_SERVICE_KEY:?}, asi que `docker compose up` se niega a arrancar
# si falta.
#
# Obligatoria y SIN valor por defecto: si falta, /agente-ajax/ falla con un
# error que lo dice, core.settings.prov se niega a arrancar y el microservicio
# lanza RuntimeError al importarse.
#
# GENERA UNA NUEVA, no copies la que hubiera antes: estaba escrita en el
# codigo de ia_service_core y en los compose, asi que esta en el historial de
# git (git log -p -S). Cualquiera con acceso al repositorio la conoce:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Copia el resultado aqui. El mismo valor, sin comillas ni espacios, es el que
# tienen que tener Django y el microservicio, o /ask respondera 403.
INTERNAL_SERVICE_KEY=
