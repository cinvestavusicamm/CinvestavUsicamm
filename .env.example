# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# En desarrollo puede quedar vacio: se usa un SQLite local (db.sqlite3).
# Si se rellena, tiene que apuntar a la base local del docker-compose; el
# proyecto se niega a arrancar contra un host remoto salvo que se exporte
# ALLOW_REMOTE_DB=1.
# En produccion es obligatoria y no admite SQLite.
DATABASE_URL=postgresql://user:password@localhost:5432/cinvestav_db

ALLOWED_HOSTS=localhost,127.0.0.1

# Microservices URLs
VALIDATION_SERVICE_URL=http://localhost:8001
BACKEND_API_URL=http://localhost:8003
MICROSERVICE_DB_URL=http://localhost:8002
DJANGO_BACKEND_URL=http://localhost:8000

# Clave compartida con el microservicio de IA. Django la manda en la cabecera
# X-Internal-Service-Key de /agente-ajax/ y el microservicio la exige en /ask.
#
# Obligatoria y SIN valor por defecto: si falta, /agente-ajax/ falla con un
# error que lo dice, y core.settings.prov se niega a arrancar.
#
# Generala aqui. Ojo con el nombre: el microservicio no lee INTERNAL_SERVICE_KEY,
# busca la suya con getenv("microAI"), y el docker-compose le pasa otra llamada
# (MICROSERVICE_SECRET) que no lee nadie. Mientras no se unifiquen, el valor de
# INTERNAL_SERVICE_KEY tiene que coincidir con el que use el
# microservicio o el chatbot recibira 403 de /ask. Ver DEUDA-8 en PLAN.md.
INTERNAL_SERVICE_KEY=
